HOST=0.0.0.0
CORS_ORIGIN=https://dealxstocks.com,https://www.dealxstocks.com
FRONTEND_URL=https://dealxstocks.com
NODE_ENV=production

ADMIN_USERNAME=admin@dealxstocks.com
ADMIN_EMAIL=admin@dealxstocks.com
ADMIN_PASSWORD=change-this-password
ADMIN_FALLBACK_USERNAME=admin
ADMIN_FALLBACK_EMAIL=admin@dealxstocks.com
ADMIN_FALLBACK_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
USER_SESSION_SECRET=generate-a-different-long-random-secret

# Admin account seeding (backend/scripts/seed-admin-account.mjs). No hardcoded
# defaults are permitted; the script fails unless credentials are supplied via
# these env vars or CLI flags (--id, --email, --password).
# ADMIN_SEED_ID=admin-main
# ADMIN_SEED_EMAIL=admin@dealxstocks.com
# ADMIN_SEED_PASSWORD=generate-a-strong-password-at-least-12-characters

FIREBASE_PROJECT_ID=dealxstocks
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@dealxstocks.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
FIREBASE_STORAGE_BUCKET=dealxstocks.firebasestorage.app

# ── Production deployment checklist (Phase 0.5 security) ───────────────────────
# 1. USER_SESSION_SECRET must be set to a unique random value (distinct from
#    ADMIN_SESSION_SECRET). Without it, every cold start on serverless platforms
#    derives the secret from other env vars; with no stable source at all, all
#    user sessions are invalidated on restart.
# 2. Rotate ADMIN_* credentials: the effective admin passwords live in the
#    Firestore adminAccounts collection (seeded on first boot from these vars).
#    Change them via /api/admin/change-password in production — do NOT rely on
#    .env edits to update an already-seeded account.
# 3. Seed or verify the admin account with the seed script:
#      node scripts/seed-admin-account.mjs --email admin@... --password '...' --apply
#    (or ADMIN_SEED_ID/ADMIN_SEED_EMAIL/ADMIN_SEED_PASSWORD env vars).
# 4. Confirm no legacy admin@123-style accounts remain in Firestore adminAccounts.
